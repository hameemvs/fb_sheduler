# Copy this file to .env and fill in what you need. Everything is optional.

# Port the web app listens on.
PORT=8080

# Where the database and secret key live. Back this folder up.
# DATA_DIR=./data

# Turns on "Draft with AI" and "Rewrite" in the editor, and the ai_draft_post tool for agents.
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Signs logins and encrypts saved channel credentials. If unset, one is generated
# in DATA_DIR/secret.key on first run. If you set it, keep it: changing it makes
# saved channels unreadable.
# APP_SECRET=at-least-16-random-characters

# Default time zone before you pick one in Settings.
# TZ_DEFAULT=Europe/London

# Set when Dispatch is served over HTTPS (behind a reverse proxy), so login cookies are HTTPS-only.
# SECURE_COOKIES=true

# Your public address, used to show the right MCP commands in Settings.
# PUBLIC_URL=https://dispatch.example.com

# How often to check for due posts (milliseconds) and how many times to try a failing post.
# SCHEDULER_INTERVAL_MS=20000
# MAX_PUBLISH_ATTEMPTS=3

# LinkedIn API version header (YYYYMM). Update it if LinkedIn retires this version.
# LINKEDIN_VERSION=202509

# Facebook Graph API version. Update it if Meta retires this version.
# FACEBOOK_GRAPH_VERSION=v23.0
